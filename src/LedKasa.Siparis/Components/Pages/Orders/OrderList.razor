@page "/orders"
@attribute [Authorize(Policy = Policies.OrdersView)]
@inject IOrderService Orders
@inject NavigationManager Navigation
@inject ILogger<OrderList> Logger

<PageTitle>Siparişler — LEDKASA</PageTitle>

<div class="lk-toolbar">
    <div>
        <h1 class="lk-page-title">Siparişler</h1>
        <p class="lk-page-sub">@(string.IsNullOrEmpty(_scopeLabel) ? "Filtreleyin, detaya gidin, süreci ilerletin." : _scopeLabel)</p>
    </div>
    <AuthorizeView Policy="@Policies.OrdersCreate">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/orders/new"
                   StartIcon="@Icons.Material.Filled.Add">Yeni sipariş</MudButton>
    </AuthorizeView>
</div>

<MudPaper Class="lk-card pa-4 mb-4" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="3">
            <CustomerNameField Value="@(_filter.Search ?? string.Empty)" ValueChanged="OnSearchValueChanged"
                               Label="Sipariş no / kişi" Required="false" FreeTextSearch="true"
                               AdornmentIcon="@Icons.Material.Filled.Search" OnEnter="() => SearchAsync()" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="OrderStatus?" @bind-Value="_filter.Status" Label="Durum" Variant="Variant.Outlined" Clearable="true">
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <MudSelectItem Value="@((OrderStatus?)status)">@DisplayNames.Status(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="DeliveryPlace?" @bind-Value="_filter.DeliveryPlace" Label="Teslim yeri" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@((DeliveryPlace?)DeliveryPlace.Sirket)">Şirket</MudSelectItem>
                <MudSelectItem Value="@((DeliveryPlace?)DeliveryPlace.Fabrika)">Fabrika</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="OrderSort" Value="_filter.Sort" ValueChanged="OnSortChanged" Label="Sırala" Variant="Variant.Outlined">
                @foreach (var sort in Enum.GetValues<OrderSort>())
                {
                    var option = sort;
                    <MudSelectItem Value="@option">@DisplayNames.Sort(option)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker @bind-Date="_from" Label="Başlangıç" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-1" OnClick="ApplyFiltersAsync">Uygula</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
}
else if (_loadError)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Siparişler yüklenemedi. Yeniden deneyin.</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync">Yeniden dene</MudButton>
}
else if (_result is { TotalCount: 0 })
{
    <MudPaper Class="lk-card pa-8 text-center" Elevation="0">
        <MudText Typo="Typo.h6">Kayıt bulunamadı</MudText>
        <MudText Color="Color.Secondary">Filtreleri temizleyin veya yeni sipariş oluşturun.</MudText>
    </MudPaper>
}
else if (_result is not null)
{
    <div class="lk-actions mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="@ExportUrl("xlsx")"
                   StartIcon="@Icons.Material.Filled.TableView" UserAttributes="DownloadAttr">Excel indir</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@ExportUrl("pdf")"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf" UserAttributes="DownloadAttr">PDF indir</MudButton>
        <MudText Color="Color.Secondary">Filtrelenmiş @_result.TotalCount sipariş</MudText>
    </div>

    <div class="d-none d-md-block">
        <MudTable Items="_result.Items" Hover="true" Breakpoint="Breakpoint.None" Elevation="0" Class="lk-table">
            <HeaderContent>
                <MudTh>Sipariş</MudTh>
                <MudTh>Kişi</MudTh>
                <MudTh>Sipariş tarihi</MudTh>
                <MudTh>Teslim</MudTh>
                <MudTh>Yer</MudTh>
                <MudTh>Durum</MudTh>
                <MudTh>Kalem / Adet</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudLink Href="@($"/orders/{context.Id}")"><strong>@context.OrderNumber</strong></MudLink>
                </MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@TurkeyTime.FormatDate(context.OrderDate)</MudTd>
                <MudTd>@TurkeyTime.FormatDate(context.DeliveryDate)</MudTd>
                <MudTd>@DisplayNames.Place(context.DeliveryPlace)</MudTd>
                <MudTd><StatusChip Status="context.Status" /></MudTd>
                <MudTd>@context.ItemCount / @context.TotalQuantity</MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    <div class="d-md-none">
        @foreach (var item in _result.Items)
        {
            <MudPaper Class="lk-card lk-mobile-card pa-4 mb-3" Elevation="0" @onclick="@(() => Open(item.Id))">
                <div class="lk-mobile-card__top">
                    <strong>@item.OrderNumber</strong>
                    <StatusChip Status="item.Status" />
                </div>
                <div>@item.CustomerName</div>
                <small>@TurkeyTime.FormatDate(item.OrderDate) → @TurkeyTime.FormatDate(item.DeliveryDate) · @DisplayNames.Place(item.DeliveryPlace)</small>
                <div class="lk-item-lines mt-2">
                    <div class="lk-item-line"><span>Kalem</span><strong>@item.ItemCount</strong></div>
                    <div class="lk-item-line"><span>Adet</span><strong>@item.TotalQuantity</strong></div>
                </div>
            </MudPaper>
        }
    </div>

    <MudPagination Count="@PageCount" Selected="_filter.Page" SelectedChanged="OnPage" Class="mt-4" />
}

@code {
    private readonly OrderListFilter _filter = new();
    private DateTime? _from;
    private PagedResult<OrderListItemDto>? _result;
    private bool _loading = true;
    private bool _loadError;
    private OrderListFilter _applied = new();

    private static readonly Dictionary<string, object> DownloadAttr = new() { ["download"] = "" };

    private int PageCount => _result is null || _result.PageSize == 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)_result.PageSize));

    [SupplyParameterFromQuery(Name = "status")]
    public int? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "scope")]
    public string? ScopeQuery { get; set; }

    private int? _appliedStatusQuery;
    private string? _appliedScopeQuery;
    private bool _queryApplied;
    private string _scopeLabel = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_queryApplied && _appliedStatusQuery == StatusQuery && _appliedScopeQuery == ScopeQuery)
            return;

        try
        {
            OrderScopes.ApplyQuery(_filter, StatusQuery, ScopeQuery);
            _from = null;
            _scopeLabel = OrderScopes.Display(_filter.Scope);
            _appliedStatusQuery = StatusQuery;
            _appliedScopeQuery = ScopeQuery;
            _queryApplied = true;
            await SearchAsync(keepScope: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sipariş listesi parametreleri uygulanamadı");
            _loadError = true;
            _loading = false;
        }
    }

    private Task ApplyFiltersAsync() => SearchAsync();

    private Task RetryAsync() => SearchAsync(keepScope: true);

    private async Task OnSearchValueChanged(string? value)
    {
        _filter.Search = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        if (_filter.Search != _applied.Search)
            await SearchAsync();
    }

    private Task OnSortChanged(OrderSort sort)
    {
        _filter.Sort = sort;
        return SearchAsync(keepScope: true);
    }

    private async Task SearchAsync(bool keepScope = false)
    {
        if (!keepScope)
        {
            _filter.Scope = OrderListScope.None;
            _scopeLabel = string.Empty;
        }

        _loading = true;
        _loadError = false;
        _filter.From = _from is null ? null : DateOnly.FromDateTime(_from.Value);
        _filter.Page = 1;
        _applied = new OrderListFilter
        {
            Search = _filter.Search,
            Status = _filter.Status,
            DeliveryPlace = _filter.DeliveryPlace,
            From = _filter.From,
            To = _filter.To,
            DateField = _filter.DateField,
            Sort = _filter.Sort,
            Scope = _filter.Scope
        };
        try
        {
            _result = await Orders.ListAsync(_filter);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sipariş listesi yüklenemedi");
            _loadError = true;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPage(int page)
    {
        _filter.Page = page;
        _loading = true;
        _loadError = false;
        try
        {
            _result = await Orders.ListAsync(_filter);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sipariş listesi sayfası yüklenemedi");
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private string ExportUrl(string ext)
    {
        var query = new List<string>
        {
            $"dateField={(int)_applied.DateField}",
            $"sort={(int)_applied.Sort}"
        };
        if (!string.IsNullOrWhiteSpace(_applied.Search))
            query.Add($"search={Uri.EscapeDataString(_applied.Search.Trim())}");
        if (_applied.Status.HasValue)
            query.Add($"status={(int)_applied.Status.Value}");
        if (_applied.DeliveryPlace.HasValue)
            query.Add($"place={(int)_applied.DeliveryPlace.Value}");
        if (_applied.From.HasValue)
            query.Add($"from={_applied.From.Value:yyyy-MM-dd}");
        if (_applied.To.HasValue)
            query.Add($"to={_applied.To.Value:yyyy-MM-dd}");
        var scope = ScopeQueryValue(_applied.Scope);
        if (scope is not null)
            query.Add($"scope={scope}");
        return $"/exports/orders/filtered.{ext}?{string.Join('&', query)}";
    }

    private static string? ScopeQueryValue(OrderListScope scope) => scope switch
    {
        OrderListScope.None => null,
        OrderListScope.Today => OrderScopes.TodayQuery,
        OrderListScope.Open => OrderScopes.OpenQuery,
        OrderListScope.WeekDelivery => OrderScopes.WeekQuery,
        OrderListScope.Overdue => OrderScopes.OverdueQuery,
        _ => throw new ArgumentOutOfRangeException(nameof(scope), scope, null)
    };

    private void Open(int id) => Navigation.NavigateTo($"/orders/{id}");
}
