@page "/orders/{Id:int}"
@attribute [Authorize(Policy = Policies.OrdersView)]
@rendermode InteractiveServer
@inject IOrderService Orders
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ICurrentUser CurrentUser

<PageTitle>Sipariş detayı — LEDKASA</PageTitle>

@if (_order is null && !_missing)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
}
else if (_missing || _order is null)
{
    <PageHeader Title="Sipariş" Parent="Siparişler" BackHref="/orders" />
    <MudAlert Severity="Severity.Warning">Sipariş bulunamadı.</MudAlert>
}
else
{
    <PageHeader Title="@_order.OrderNumber"
                Parent="Siparişler"
                BackHref="/orders"
                Subtitle="@($"{_order.CustomerName} · {DisplayNames.Place(_order.DeliveryPlace)}")">
        <div class="lk-actions">
            <AuthorizeView Policy="@Policies.OrdersEdit">
                @if (_order.CanEdit)
                {
                    <MudButton Variant="Variant.Outlined" Href="@($"/orders/{_order.Id}/edit")">Düzenle</MudButton>
                }
            </AuthorizeView>
        </div>
    </PageHeader>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudPaper Class="lk-card pa-4 mb-4" Elevation="0">
                <div class="lk-kv">
                    <span>Sipariş tarihi</span><strong>@TurkeyTime.FormatDate(_order.OrderDate)</strong>
                    <span>Teslim tarihi</span><strong>@TurkeyTime.FormatDate(_order.DeliveryDate)</strong>
                    <span>Teslim yeri</span><strong>@DisplayNames.Place(_order.DeliveryPlace)</strong>
                    <span>Durum</span><StatusChip Status="_order.Status" />
                    @if (CurrentUser.CanViewPrices)
                    {
                        <span>Toplam</span><strong>@TurkeyTime.FormatMoney(_order.GrandTotal)</strong>
                    }
                    <span>Not</span><strong>@(_order.Notes ?? "—")</strong>
                </div>
            </MudPaper>

            @foreach (var item in _order.Items)
            {
                <OrderItemCard Item="item" ShowPrices="CurrentUser.CanViewPrices" />
            }
        </MudItem>
        <MudItem xs="12" md="4">
            <AuthorizeView Policy="@Policies.OrdersChangeStatus">
                <MudPaper Class="lk-card pa-4" Elevation="0">
                    <MudText Typo="Typo.h6">Süreç</MudText>
                    @if (_order.AllowedNextStatuses.Count == 0)
                    {
                        <MudText Color="Color.Secondary" Class="mt-2">Bu siparişin durumu kilitli.</MudText>
                    }
                    else
                    {
                        @foreach (var next in _order.AllowedNextStatuses)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="@(next == OrderStatus.Iptal ? Color.Error : Color.Primary)"
                                       FullWidth="true" Class="mt-2"
                                       OnClick="() => ChangeStatus(next)">
                                @DisplayNames.Status(next)
                            </MudButton>
                        }
                    }
                </MudPaper>
            </AuthorizeView>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private OrderDetailDto? _order;
    private bool _missing;

    protected override async Task OnInitializedAsync()
    {
        _order = await Orders.GetAsync(Id);
        _missing = _order is null;
    }

    private async Task ChangeStatus(OrderStatus next)
    {
        if (_order is null) return;
        try
        {
            await Orders.ChangeStatusAsync(_order.Id, next, _order.RowVersion);
            _order = await Orders.GetAsync(Id);
            Snackbar.Add("Durum güncellendi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
