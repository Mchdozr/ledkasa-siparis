@page "/admin/products"
@attribute [Authorize(Policy = Policies.AdminFeatures)]
@rendermode InteractiveServer
@inject IProductService ProductsApi
@inject ISnackbar Snackbar

<PageTitle>Ürünler — LEDKASA</PageTitle>

<h1 class="lk-page-title">Ürün kataloğu</h1>
<p class="lk-page-sub">Sipariş kalemlerinde seçilen ürünler. Yeni ürün ekleyebilirsiniz.</p>

<MudPaper Class="lk-card pa-4 mb-4" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="_newName" Label="Yeni ürün" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-1" OnClick="CreateAsync">Ekle</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@foreach (var product in _products)
{
    <MudPaper Class="lk-card pa-4 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField Value="product.Name" ValueChanged="(string v) => productName[product.Id] = v"
                              Label="Ad" Variant="Variant.Outlined" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" Value="product.SortOrder" ValueChanged="v => productSort[product.Id] = v" Label="Sıra" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="2" Class="d-flex align-center">
                <MudSwitch T="bool"
                           Value="productActive.GetValueOrDefault(product.Id, product.IsActive)"
                           ValueChanged="@(v => productActive[product.Id] = v)"
                           Color="Color.Success" Label="Aktif" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Outlined" OnClick="() => SaveAsync(product)">Kaydet</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private IReadOnlyList<ProductDto> _products = [];
    private readonly Dictionary<int, string> productName = [];
    private readonly Dictionary<int, int> productSort = [];
    private readonly Dictionary<int, bool> productActive = [];
    private string _newName = string.Empty;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _products = await ProductsApi.ListAsync(activeOnly: false);
        foreach (var product in _products)
        {
            productName[product.Id] = product.Name;
            productSort[product.Id] = product.SortOrder;
            productActive[product.Id] = product.IsActive;
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            await ProductsApi.CreateAsync(_newName);
            _newName = string.Empty;
            await ReloadAsync();
            Snackbar.Add("Ürün eklendi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveAsync(ProductDto product)
    {
        await ProductsApi.UpdateAsync(
            product.Id,
            productName.GetValueOrDefault(product.Id, product.Name),
            productActive.GetValueOrDefault(product.Id, product.IsActive),
            productSort.GetValueOrDefault(product.Id, product.SortOrder));
        Snackbar.Add("Güncellendi.", Severity.Success);
        await ReloadAsync();
    }
}
