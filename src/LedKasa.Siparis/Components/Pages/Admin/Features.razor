@page "/admin/features"
@attribute [Authorize(Policy = Policies.AdminFeatures)]
@rendermode InteractiveServer
@inject IExtraFeatureService FeaturesApi
@inject ISnackbar Snackbar

<PageTitle>Ekstra özellikler — LEDKASA</PageTitle>

<h1 class="lk-page-title">Ekstra özellik kataloğu</h1>
<p class="lk-page-sub">Sipariş kalemlerinde seçilen yönetilebilir özellikler.</p>

<MudPaper Class="lk-card pa-4 mb-4" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="_newName" Label="Yeni özellik" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-1" OnClick="CreateAsync">Ekle</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@foreach (var feature in _features)
{
    <MudPaper Class="lk-card pa-4 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField Value="feature.Name" ValueChanged="(string v) => featureName[feature.Id] = v"
                              Label="Ad" Variant="Variant.Outlined" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" Value="feature.SortOrder" ValueChanged="v => featureSort[feature.Id] = v" Label="Sıra" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="2" Class="d-flex align-center">
                <MudSwitch T="bool"
                           Value="featureActive.GetValueOrDefault(feature.Id, feature.IsActive)"
                           ValueChanged="@(v => featureActive[feature.Id] = v)"
                           Color="Color.Success" Label="Aktif" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Outlined" OnClick="() => SaveAsync(feature)">Kaydet</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private IReadOnlyList<ExtraFeatureDto> _features = [];
    private readonly Dictionary<int, string> featureName = [];
    private readonly Dictionary<int, int> featureSort = [];
    private readonly Dictionary<int, bool> featureActive = [];
    private string _newName = string.Empty;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _features = await FeaturesApi.ListAsync(activeOnly: false);
        foreach (var feature in _features)
        {
            featureName[feature.Id] = feature.Name;
            featureSort[feature.Id] = feature.SortOrder;
            featureActive[feature.Id] = feature.IsActive;
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            await FeaturesApi.CreateAsync(_newName);
            _newName = string.Empty;
            await ReloadAsync();
            Snackbar.Add("Özellik eklendi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveAsync(ExtraFeatureDto feature)
    {
        await FeaturesApi.UpdateAsync(
            feature.Id,
            featureName.GetValueOrDefault(feature.Id, feature.Name),
            featureActive.GetValueOrDefault(feature.Id, feature.IsActive),
            featureSort.GetValueOrDefault(feature.Id, feature.SortOrder));
        Snackbar.Add("Güncellendi.", Severity.Success);
        await ReloadAsync();
    }
}
