<MudPaper Class="lk-card pa-4 mb-3" Elevation="0">
    <div class="lk-item-lines">
        <div class="lk-item-line">
            <span>Ürün</span>
            <strong>@(string.IsNullOrWhiteSpace(Item.ProductName) ? "Ürün" : Item.ProductName)</strong>
        </div>
        <div class="lk-item-line">
            <span>Ölçü</span>
            <strong>@DisplayNames.Size(Item.WidthCm, Item.HeightCm, Item.DepthCm)</strong>
        </div>
        <div class="lk-item-line">
            <span>Yön</span>
            <strong>@DisplayNames.Side(Item.Side)</strong>
        </div>
        <div class="lk-item-line">
            <span>Adet</span>
            <strong>@Item.Quantity</strong>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Item.Note))
    {
        <MudText Typo="Typo.caption" Class="mt-2">@Item.Note</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public OrderItemDto Item { get; set; } = default!;
}
