<MudPaper Class="lk-card pa-4 mb-3" Elevation="0">
    <div class="lk-item-lines">
        <div class="lk-item-line">
            <span>Ürün</span>
            <strong>@(string.IsNullOrWhiteSpace(Item.ProductName) ? "Ürün" : Item.ProductName)</strong>
        </div>
        <div class="lk-item-line">
            <span>Ölçü</span>
            <strong>@Item.WidthCm.ToString("0.##", TurkeyTime.Culture) × @Item.HeightCm.ToString("0.##", TurkeyTime.Culture) cm</strong>
        </div>
        <div class="lk-item-line">
            <span>Adet</span>
            <strong>@Item.Quantity</strong>
        </div>
        <div class="lk-item-line">
            <span>Fiyat</span>
            <strong>@TurkeyTime.FormatMoneyLine(Item.UnitPrice, Item.Quantity, Item.LineTotal, Currency)</strong>
        </div>
    </div>
    @if (Item.ExtraFeatureNames.Count > 0)
    {
        <div class="mt-3">
            @foreach (var name in Item.ExtraFeatureNames)
            {
                <MudChip T="string" Size="Size.Small">@name</MudChip>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Item.Note))
    {
        <MudText Typo="Typo.caption" Class="mt-2">@Item.Note</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public OrderItemDto Item { get; set; } = default!;
    [Parameter] public Currency Currency { get; set; } = Currency.Try;
}
