@inject IOrderService Orders

<MudAutocomplete T="string"
                 Value="Value"
                 ValueChanged="HandleValueChangedAsync"
                 Label="@Label"
                 Variant="Variant.Outlined"
                 Required="Required"
                 RequiredError="Sipariş veren kişi zorunludur."
                 Adornment="@(AdornmentIcon is null ? Adornment.End : Adornment.Start)"
                 AdornmentIcon="@AdornmentIcon"
                 OnKeyDown="HandleKeyDown"
                 OnKeyUp="HandleKeyUpAsync"
                 ItemTemplate="@(FreeTextSearch ? SearchItemTemplate : null)"
                 SearchFunc="SearchAsync"
                 MinCharacters="0"
                 MaxItems="@((int?)null)"
                 MaxHeight="400"
                 DebounceInterval="0"
                 OpenOnFocus="true"
                 CoerceValue="true"
                 ResetValueOnEmptyText="true"
                 Clearable="true"
                 Dense="true">
    <NoItemsTemplate>
        <MudText Typo="Typo.caption" Class="px-4 py-2">Eşleşen kişi yok. Yeni isim yazabilirsiniz.</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Sipariş veren kişi";
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public EventCallback OnEnter { get; set; }
    [Parameter] public string? AdornmentIcon { get; set; }
    [Parameter] public bool FreeTextSearch { get; set; }

    private PersonSuggestions _suggestions = new([], []);
    private string? _typedText;
    private Task? _loadTask;
    private bool _enterDown;
    private bool _changedDuringEnter;

    private async Task HandleValueChangedAsync(string value)
    {
        if (_enterDown)
            _changedDuringEnter = true;
        await ValueChanged.InvokeAsync(value);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            _enterDown = true;
    }

    private async Task HandleKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or "NumpadEnter"))
            return;

        var alreadyApplied = _changedDuringEnter;
        _enterDown = false;
        _changedDuringEnter = false;
        if (!alreadyApplied)
            await OnEnter.InvokeAsync();
    }

    protected override Task OnInitializedAsync() => EnsureAsync();

    private Task EnsureAsync()
    {
        return _loadTask ??= LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _suggestions = await Orders.ListPersonSuggestionsAsync();
        }
        catch (Exception)
        {
            _suggestions = new PersonSuggestions([], []);
        }
    }

    private async Task<IEnumerable<string>> SearchAsync(string value, CancellationToken _)
    {
        await EnsureAsync();
        var trimmed = value?.Trim() ?? string.Empty;
        if (FreeTextSearch)
        {
            if (trimmed.Length == 0)
                return _suggestions.PreviousCustomers.Prepend(string.Empty);

            _typedText = trimmed;
            return PersonNameSearch.Filter(_suggestions.All, trimmed)
                .Where(name => !string.Equals(name, trimmed, StringComparison.Ordinal))
                .Prepend(trimmed);
        }

        if (trimmed.Length == 0 || string.Equals(trimmed, Value, StringComparison.Ordinal))
            return _suggestions.PreviousCustomers;

        return PersonNameSearch.Filter(_suggestions.All, trimmed);
    }

    private RenderFragment<string> SearchItemTemplate => item => @<span>
        @if (string.IsNullOrEmpty(item))
        {
            <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="mr-2" Style="vertical-align: middle;" />
            <span>Tüm siparişler</span>
        }
        else if (string.Equals(item, _typedText, StringComparison.Ordinal) && !_suggestions.All.Contains(item))
        {
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-2" Style="vertical-align: middle;" />
            <span>"@item" ile ara</span>
        }
        else
        {
            @item
        }
    </span>;
}
