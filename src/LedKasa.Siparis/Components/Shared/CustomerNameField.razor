@inject IOrderService Orders

<MudAutocomplete T="string"
                 Value="Value"
                 ValueChanged="ValueChanged"
                 Label="Sipariş veren kişi"
                 Variant="Variant.Outlined"
                 Required="true"
                 RequiredError="Sipariş veren kişi zorunludur."
                 SearchFunc="SearchAsync"
                 MinCharacters="0"
                 MaxItems="@((int?)null)"
                 MaxHeight="400"
                 DebounceInterval="0"
                 OpenOnFocus="true"
                 CoerceValue="true"
                 ResetValueOnEmptyText="true"
                 Clearable="true"
                 Dense="true">
    <NoItemsTemplate>
        <MudText Typo="Typo.caption" Class="px-4 py-2">Eşleşen kişi yok. Yeni isim yazabilirsiniz.</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private PersonSuggestions _suggestions = new([], []);
    private Task? _loadTask;

    protected override Task OnInitializedAsync() => EnsureAsync();

    private Task EnsureAsync()
    {
        return _loadTask ??= LoadAsync();
    }

    private async Task LoadAsync()
    {
        _suggestions = await Orders.ListPersonSuggestionsAsync();
    }

    private async Task<IEnumerable<string>> SearchAsync(string value, CancellationToken _)
    {
        await EnsureAsync();
        var trimmed = value?.Trim() ?? string.Empty;
        if (trimmed.Length == 0 || string.Equals(trimmed, Value, StringComparison.Ordinal))
            return _suggestions.PreviousCustomers;

        return PersonNameSearch.Filter(_suggestions.All, trimmed);
    }
}
