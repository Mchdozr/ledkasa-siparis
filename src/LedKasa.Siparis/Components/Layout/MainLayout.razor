@inherits LayoutComponentBase
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@using LedKasa.Siparis.Theming
@inject IBrowserViewportService BrowserViewport

<MudThemeProvider Theme="LedKasaTheme.Create()" @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="0" Class="lk-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       Class="d-lg-none" OnClick="ToggleDrawer" aria-label="Menü" />
        <a href="/" class="lk-brand" aria-label="Anasayfa">
            <span class="lk-mark">LK</span>
            <div>
                <strong>LEDKASA</strong>
                <small>Sipariş Operasyonu</small>
            </div>
        </a>
        <MudSpacer />
        <OfflineBanner />
        <InstallPrompt />
        <AuthorizeView>
            <Authorized>
                <MudText Class="d-none d-sm-block mr-3" Typo="Typo.caption">
                    @context.User.FindFirst("display_name")?.Value
                </MudText>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Çıkış</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Class="@DrawerClass" Breakpoint="Breakpoint.Lg"
               Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never"
               OverlayAutoClose="true">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="lk-main">
        <div class="lk-page">
            @Body
        </div>
        <BottomNav />
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private bool _drawerReady;
    private bool _subscribed;
    private bool _wasDesktop;

    public Guid Id { get; } = Guid.NewGuid();

    private string DrawerClass => _drawerReady ? "lk-drawer lk-drawer-ready" : "lk-drawer";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_subscribed)
            return;

        try
        {
            await BrowserViewport.SubscribeAsync(this, fireImmediately: true);
            _subscribed = true;
        }
        catch (InvalidOperationException)
        {
        }
    }

    public Task NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        var desktop = IsDesktop(args.Breakpoint);
        if (!_drawerReady)
        {
            _drawerOpen = desktop;
            _drawerReady = true;
            _wasDesktop = desktop;
            return InvokeAsync(StateHasChanged);
        }

        if (desktop)
            _drawerOpen = true;
        else if (_wasDesktop)
            _drawerOpen = false;

        _wasDesktop = desktop;
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    public async ValueTask DisposeAsync()
    {
        if (_subscribed)
            await BrowserViewport.UnsubscribeAsync(this);
    }

    private static bool IsDesktop(Breakpoint breakpoint) =>
        breakpoint is Breakpoint.Lg or Breakpoint.Xl or Breakpoint.Xxl;
}
